# Copy this file to config.env and edit it before running install.sh.
# Single-quote values that contain spaces or shell metacharacters.

HOTSPOT_SSID=PREP-LIBRARY
HOTSPOT_PASSWORD=REPLACE-WITH-A-LONG-PASSWORD
WIFI_COUNTRY=US
BOX_HOSTNAME=box
HOTSPOT_ADDRESS=10.10.10.1/24
# core, sd256, sd512, or full. Match this to the capacity described in README.md.
CONTENT_PROFILE=full
UNIQUE_CLONE_IDENTITY=true
