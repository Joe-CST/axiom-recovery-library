#!/usr/bin/env bash
set -Eeuo pipefail

ZIM_DIR=/srv/prepper-library/kiwix
LIBRARY="${ZIM_DIR}/library.xml"
TMP="${ZIM_DIR}/.library.xml.new"

rm -f "${TMP}"
mapfile -d '' ZIMS < <(find "${ZIM_DIR}" -maxdepth 1 -type f -name '*.zim' -print0 | sort -z)

if (( ${#ZIMS[@]} == 0 )); then
  rm -f "${LIBRARY}"
  printf 'No ZIM archives found in %s\n' "${ZIM_DIR}"
  exit 0
fi

ADDED=0
for zim in "${ZIMS[@]}"; do
  if [[ -e "${zim}.aria2" ]]; then
    printf 'Skipping an archive that is still downloading: %s\n' "${zim}" >&2
    continue
  fi
  if [[ ! -e "${zim}.verified" ]]; then
    printf 'Skipping an archive that has not passed verification: %s\n' "${zim}" >&2
    continue
  fi
  if kiwix-manage "${TMP}" add "${zim}" >/dev/null; then
    ((ADDED += 1))
  else
    printf 'Skipping an unreadable or duplicate archive: %s\n' "${zim}" >&2
  fi
done

if (( ADDED == 0 )); then
  rm -f "${LIBRARY}" "${TMP}"
  printf 'No complete ZIM archives are ready in %s\n' "${ZIM_DIR}"
  exit 0
fi

chown www-data:www-data "${TMP}"
chmod 0644 "${TMP}"
mv -f "${TMP}" "${LIBRARY}"
printf 'Indexed %d ZIM archive(s).\n' "${ADDED}"

